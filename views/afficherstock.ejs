<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>📋 Stock</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- jsPDF -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

  <style>
    :root {
      --brand: #4f46e5;
      --brand-dark: #4338ca;
    }
    * { font-family: "Poppins", sans-serif; }

    body {
      background: linear-gradient(135deg, #f9fafb 0%, #eef2ff 100%);
      min-height: 100vh;
    }

    header {
      background: var(--brand);
      color: #fff;
      padding: 1rem 0;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .card {
      border: none;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      background-color: #fff;
    }

    .table thead {
      background: var(--brand);
      color: #fff;
    }

    .btn-brand {
      background: var(--brand);
      color: white;
      border-radius: 50px;
      padding: 0.4rem 1.1rem;
    }

    .btn-brand:hover {
      background: var(--brand-dark);
      transform: scale(1.05);
    }

    footer {
      color: #6b7280;
      font-size: 0.9rem;
      padding: 1rem;
      margin-top: 2rem;
    }

    .filter-input {
      border-radius: 8px;
      border: 1px solid #ccc;
      padding: 0.4rem 0.6rem;
      width: 100%;
    }
  </style>
</head>

<body>
  <!-- ✅ Inclusion du header -->
 
  <main class="container py-4">
    <div class="card p-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <h3 class="fw-semibold text-primary">📦 Stock</h3>
        <div class="d-flex flex-wrap gap-2">
          <a href="/stock/ajouter" class="btn btn-warning">
            <i class="bi bi-plus-circle me-1"></i> Ajouter au stock
          </a>
          <button id="exportPDF" class="btn btn-brand">
            <i class="bi bi-filetype-pdf me-1"></i> PDF Global
          </button>
          <button id="exportExcel" class="btn btn-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel
          </button>
        </div>
      </div>

      <!-- 🧠 Filtres -->
      <div class="mb-3">
        <input list="designationList" id="designationFilter" class="filter-input" placeholder="Rechercher par désignation" />
        <datalist id="designationList"></datalist>
      </div>

      <!-- ✅ Tableau -->
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th>Désignation</th>
              <th>Quantité</th>
              <th>Date d’entrée</th>
              <th class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (stocks.length === 0) { %>
              <tr>
                <td colspan="4" class="text-center text-muted py-5">
                  <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                  Aucun article en stock
                </td>
              </tr>
            <% } else { %>
              <% stocks.forEach(stock => { %>
                <tr>
                  <td><%= stock.designation %></td>
                  <td><%= stock.qte %></td>
                  <td><%= new Date(stock.date_entree).toLocaleDateString('fr-FR') %></td>
                  <td class="text-center">
                    <a href="/stock/modifier/<%= stock._id %>" class="btn  btn-warning m-2" title="Modifier">
                      <i class="bi bi-pencil-square"></i>
                    </a>
                    <a href="/stock/supprimer/<%= stock._id %>" class="btn btn-danger m-2" title="Supprimer"
                      onclick="return confirm('Voulez-vous vraiment supprimer cet article ?')">
                      <i class="bi bi-trash3"></i>
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <footer class="text-center">
    © <%= new Date().getFullYear() %> <b>Gestion du Matériel - APC Zighoud Youcef</b>
  </footer>

  <!-- Librairies -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

  <script>
    // ✅ Remplir la liste des désignations
    document.addEventListener("DOMContentLoaded", () => {
      const designations = new Set();
      document.querySelectorAll("tbody tr").forEach(tr => {
        const firstCell = tr.querySelector("td");
        if (firstCell) designations.add(firstCell.textContent.trim());
      });
      const datalist = document.getElementById("designationList");
      designations.forEach(val => datalist.innerHTML += `<option value="${val}">`);
    });

    // ✅ Filtrage dynamique
    document.getElementById("designationFilter").addEventListener("input", e => {
      const filter = e.target.value.toLowerCase();
      document.querySelectorAll("tbody tr").forEach(tr => {
        const designation = tr.children[0].textContent.toLowerCase();
        tr.style.display = designation.includes(filter) ? "" : "none";
      });
    });

    // ✅ Export PDF
    document.getElementById("exportPDF").addEventListener("click", () => {
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF("landscape", "mm", "a4");
      pdf.setFontSize(16);
      pdf.text("  Stock - APC Zighoud Youcef", 148, 15, { align: "center" });
      pdf.setFontSize(11);
      pdf.text(`Date : ${new Date().toLocaleDateString()}`, 14, 22);

      const table = document.querySelector("table");
      const head = [];
      const body = [];

      table.querySelectorAll("thead th").forEach(th => head.push(th.textContent.trim()));
      table.querySelectorAll("tbody tr").forEach(tr => {
        if (tr.style.display !== "none") {
          const row = [];
          tr.querySelectorAll("td").forEach((td, i) => {
            if (i < 3) row.push(td.textContent.trim());
          });
          body.push(row);
        }
      });

      if (body.length === 0) return alert("Aucune donnée à exporter !");

      pdf.autoTable({
        head: [head.slice(0, 3)],
        body: body,
        startY: 30,
        theme: "striped",
        headStyles: { fillColor: [79, 70, 229], textColor: 255 },
      });

      pdf.save("Stock_APC_Zighoud_Youcef.pdf");
    });

    // ✅ Export Excel
    document.getElementById("exportExcel").addEventListener("click", () => {
      const table = document.querySelector("table");
      const wb = XLSX.utils.book_new();
      const ws_data = [["Désignation", "Quantité", "Date d’entrée"]];
      table.querySelectorAll("tbody tr").forEach(tr => {
        if (tr.style.display !== "none") {
          const row = [];
          tr.querySelectorAll("td").forEach((td, i) => {
            if (i < 3) row.push(td.textContent.trim());
          });
          ws_data.push(row);
        }
      });
      if (ws_data.length === 1) return alert("Aucune donnée à exporter !");
      const ws = XLSX.utils.aoa_to_sheet(ws_data);
      XLSX.utils.book_append_sheet(wb, ws, "Stock");
      XLSX.writeFile(wb, "Stock_APC_Zighoud_Youcef.xlsx");
    });
  </script>
</body>
</html>
