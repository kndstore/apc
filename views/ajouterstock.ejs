<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>➕ Ajouter au Stock</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <!-- Police -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --brand: #4f46e5;
      --brand-dark: #4338ca;
    }
    * { font-family: "Poppins", sans-serif; }

    body {
      background: linear-gradient(135deg, #f9fafb 0%, #eef2ff 100%);
      min-height: 100vh;
    }

    .card {
      border: none;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      background-color: #fff;
    }

    .btn-brand {
      background: var(--brand);
      color: white;
      border-radius: 50px;
      padding: 0.5rem 1.4rem;
      font-weight: 500;
    }

    .btn-brand:hover {
      background: var(--brand-dark);
      transform: scale(1.05);
    }

    .form-label {
      font-weight: 500;
    }

    footer {
      color: #6b7280;
      font-size: 0.9rem;
      padding: 1rem;
      margin-top: 2rem;
    }
  </style>
</head>

<body>
 
  <main class="container py-5">
    <div class="card p-5 mx-auto" style="max-width: 600px;">
      <h3 class="text-center text-primary mb-4">
        <i class="bi bi-box-seam me-2"></i>Ajouter un Article au Stock
      </h3>

      <form action="/stock/ajouter" method="POST">
        <div class="mb-3">
          <label for="designation" class="form-label">Désignation</label>
          <input type="text" id="designation" name="designation" class="form-control" placeholder="Ex : Imprimante HP LaserJet" required>
        </div>

        <div class="mb-3">
          <label for="qte" class="form-label">Quantité</label>
          <input type="number" id="qte" name="qte" class="form-control" placeholder="Ex : 5" min="1" required>
        </div>

        <div class="mb-3">
          <label for="date_entree" class="form-label">Date d’entrée</label>
          <input type="date" id="date_entree" name="date_entree" class="form-control" required>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
          <a href="/stock" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle me-1"></i> Retour
          </a>
          <button type="submit" class="btn btn-brand">
            <i class="bi bi-check-circle me-1"></i> Ajouter
          </button>
        </div>
      </form>
    </div>
  </main>

  <footer class="text-center">
    © <%= new Date().getFullYear() %> <b>Gestion du Matériel - APC Zighoud Youcef</b>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<% if (typeof message !== 'undefined') { %>
<script>
  alert("<%= message %>");
</script>
<% } %>

</body>
</html>
