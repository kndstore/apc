<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>📧 Envoyer un Email</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light py-5">

  <div class="container col-md-6">
    <h2 class="text-center mb-4">📤 Envoyer un Email</h2>

    <% if (typeof message !== 'undefined') { %>
      <div class="alert alert-<%= success ? 'success' : 'danger' %> text-center">
        <%= message %>
      </div>
    <% } %>

    <form action="/envoyer-email" method="POST" class="p-4 shadow rounded bg-white">
      <div class="mb-3">
        <label class="form-label">Destinataire</label>
        <input type="email" name="to" class="form-control" placeholder="exemple@gmail.com" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Sujet</label>
        <input type="text" name="subject" class="form-control" placeholder="Sujet de l'email" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Message</label>
        <textarea name="message" rows="5" class="form-control" placeholder="Écris ton message ici..." required></textarea>
      </div>

      <div class="text-center">
        <button type="submit" class="btn btn-primary px-4">📨 Envoyer</button>
      </div>
    </form>
  </div>
 <div class="text-center">
      <a href="/afficherarticles" class="back-link">
        <i class="bi bi-arrow-left"></i> Retour à la liste
      </a>
    </div>
</body>
</html>
