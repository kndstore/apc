<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>➕ Ajouter un Article</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Icônes -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Police Poppins -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --brand: #4f46e5;
      --brand-light: #eef2ff;
    }

    * {
      font-family: "Poppins", sans-serif;
    }
  .pere {
       display: flex;
       flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    

    .card {
      border: none;
      border-radius: 18px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      background-color: #fff;
      animation: fadeInUp 0.8s ease;
      max-width: 550px;
      width: 100%;
      padding: 2rem;
    }

    h1 {
      color: var(--brand);
      font-weight: 600;
      font-size: 1.8rem;
      text-align: center;
      margin-bottom: 1.5rem;
      animation: fadeInDown 0.8s ease;
    }

    label {
      font-weight: 500;
      color: #374151;
      margin-bottom: 0.3rem;
    }

    .form-control {
      border-radius: 10px;
      transition: all 0.25s ease;
    }

    .form-control:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 0.15rem rgba(79, 70, 229, 0.25);
    }

    .btn-brand {
      background-color: var(--brand);
      color: white;
      border-radius: 10px;
      font-weight: 500;
      transition: all 0.3s ease;
    }

    .btn-brand:hover {
      background-color: #4338ca;
      transform: translateY(-2px);
      box-shadow: 0 4px 10px rgba(79, 70, 229, 0.3);
    }

    .back-link {
      display: inline-block;
      margin-top: 1rem;
      text-decoration: none;
      color: var(--brand);
      font-weight: 500;
      transition: all 0.3s ease;
    }

    .back-link:hover {
      color: #4338ca;
      text-decoration: underline;
    }

    /* --- Animations --- */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-30px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>

<body>
 
    <div class="pere">
  <div class="card">
    <h1>➕ Ajouter un Article</h1>

    <form action="/ajouter" method="POST">
      <div class="mb-3">
        <label for="designation">Désignation :</label>
        
     <input 
    list="designationList"
    id="designation"
    name="designation"
    class="form-control"
    placeholder="Ex : Ordinateur Dell"
    required
  >
  <datalist id="designationList"></datalist>
    
      </div>

      <div class="mb-3">
        <label for="qte">Quantité :</label>
        <input type="number" id="qte" name="qte" class="form-control" placeholder="Ex : 10" required>
      </div>

      <div class="mb-3">
        <label for="numero">Numéro de série :</label>
        <input type="text" id="numero" name="numero" class="form-control" placeholder="Ex : SN-456789" required>
      </div>

      <div class="mb-3">
        <label for="date">Date de dotation :</label>
        <input type="date" id="date" name="date" class="form-control" required>
      </div>

      <div class="mb-4">
        <label for="section">Section :</label>
        
     <input 
    list="sectionsList"
    id="section"
    name="section"
    class="form-control"
    placeholder="Ex : Informatique"
    required
  >
  <datalist id="sectionsList">
    <% sections.forEach(section => { %>
      <option value="<%= section.section_name %>"></option>
    <% }) %>
  </datalist>
     
      </div>

      <div class="d-grid">
        <button type="submit" class="btn btn-brand">
          <i class="bi bi-check2-circle me-1"></i> Enregistrer
        </button>
      </div>
    </form>

    <div class="text-center">
      <a href="/afficherarticles" class="back-link">
        <i class="bi bi-arrow-left"></i> Retour à la liste
      </a>
    </div>
  </div>
    </div>
  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


<script>
  // ✅ Charger automatiquement les désignations existantes
  fetch('/designations')
    .then(res => res.json())
    .then(data => {
      const dataList = document.getElementById('designationList');
      data.forEach(item => {
        const option = document.createElement('option');
        option.value = item;
        dataList.appendChild(option);
      });
    })
    .catch(err => console.error('Erreur chargement désignations:', err));
</script>


</body>
</html>
