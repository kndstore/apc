<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>✏️ Modifier un article</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Icônes -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Police Poppins -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --brand: #6366f1;
      --bg-dark: #0f172a;
      --card-dark: #1e293b;
      --text-light: #f8fafc;
    }

    * {
      font-family: "Poppins", sans-serif;
      transition: all 0.3s ease;
    }

    body {


      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: var(--text-light);
      min-height: 100vh;
      
      
    }

    .card {
      background: var(--card-dark);
      border: none;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
      padding: 2rem;
      width: 100%;
      max-width: 550px;
      animation: fadeInUp 0.8s ease;
    }

    h1 {
      color: var(--brand);
      font-weight: 600;
      text-align: center;
      margin-bottom: 1.5rem;
      animation: fadeInDown 0.8s ease;
    }

    label {
      font-weight: 500;
      color: #cbd5e1;
      margin-bottom: 0.3rem;
    }

    .form-control {
      background-color: #0f172a;
      color: var(--text-light);
      border: 1px solid #334155;
      border-radius: 10px;
    }

    .form-control:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.3);
    }

    .btn-brand {
      background-color: var(--brand);
      color: white;
      font-weight: 500;
      border-radius: 10px;
      transition: all 0.3s ease;
    }

    .btn-brand:hover {
      background-color: #4f46e5;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }

    .back-link {
      display: inline-block;
      margin-top: 1rem;
      text-decoration: none;
      color: #94a3b8;
      font-weight: 500;
      transition: all 0.3s ease;
    }

    .back-link:hover {
      color: var(--brand);
      text-decoration: underline;
    }

    /* Animations */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(25px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-25px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .pere {
       display: flex;
       flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    
  </style>
</head>

<body>

 <div class="pere">
    <div class="card">
    <h1>✏️ Modifier l’article</h1>

    <form action="/modifier/<%= article._id %>" method="POST">
      <div class="mb-3">
        <label for="designation">Désignation :</label>
        <input type="text" id="designation" name="designation" class="form-control" value="<%= article.designation %>" required>
      </div>

      <div class="mb-3">
        <label for="qte">Quantité :</label>
        <input type="number" id="qte" name="qte" class="form-control" value="<%= article.qte %>" required>
      </div>

      <div class="mb-3">
        <label for="numero">Numéro de série :</label>
        <input type="text" id="numero" name="numero" class="form-control" value="<%= article.numero %>" required>
      </div>

      <div class="mb-3">
        <label for="date">Date de dotation :</label>
        <input type="date" id="date" name="date" class="form-control" value="<%= article.date.toISOString().split('T')[0] %>" required>
      </div>

      <div class="mb-4">
         <input 
         value="<%= article.section %>"
    list="sectionsList"
    id="section"
    name="section"
    class="form-control"
    placeholder="Ex : Informatique"
    required
  >
  <datalist id="sectionsList"  >
    <% sections.forEach(section => { %>
      <option value="<%= section.section_name %>"></option>
    <% }) %>
  </datalist>
    
      </div>

      <div class="d-grid">
        <button type="submit" class="btn btn-brand">
          <i class="bi bi-check-circle me-1"></i> Mettre à jour
        </button>
      </div>
    </form>

    <div class="text-center">
      <a href="/" class="back-link">
        <i class="bi bi-arrow-left"></i> Retour à la liste
      </a>
    </div>
  </div>
  </div>
  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
