<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>📋 Liste des Articles</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <!-- Police -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- jsPDF -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

  <style>
    :root {
      --brand: #4f46e5;
      --brand-dark: #4338ca;
    }
    * { font-family: 'Inter', sans-serif; }

    body {
      background: linear-gradient(135deg, #f9fafb 0%, #eef2ff 100%);
      
      min-height: 100vh;
    }

    header {
      background: var(--brand);
      color: #fff;
      padding: 1rem 0;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .card {
      border: none;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      background-color: #fff;
    }

    .table thead {
      background: var(--brand);
      color: #fff;
    }

    .btn-brand {
      background: var(--brand);
      color: white;
      border-radius: 50px;
      padding: 0.4rem 1.1rem;
    }

    .btn-brand:hover {
      background: var(--brand-dark);
      color: white;
      transform: scale(1.05);
    }
    .btn-warning:hover {
      background: gold;
      transform: scale(1.05);
    }
     .btn-success:hover {
      background: rgb(3, 145, 3);
      transform: scale(1.05);
    }
    .btn-danger:hover {
      background: rgb(3, 145, 3);
      transform: scale(1.05);
    }
    footer {
      color: #6b7280;
      font-size: 0.9rem;
      padding: 1rem;
      margin-top: 2rem;
    }

    .filter-input {
      border-radius: 8px;
      border: 1px solid #ccc;
      padding: 0.4rem 0.6rem;
      width: 200px;
    }

  .action{display: flex;
      flex-direction: row;   /* Empiler les boutons verticalement */
      align-items: center;      /* Centrage horizontal */
      justify-content: center;  /* Centrage vertical dans la cellule */
      gap: 6px;                 /* Espacement entre les boutons */
      padding: 8px 0;
    background: #4338ca;}

      /* Taille des boutons */
.actions .btn {
  width: 35px;
  height: 35px;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 8px;
}

  .btn-3d {
  position: relative;
  border: none;
  background: linear-gradient(145deg, #327ef0, #084298);
  color: #fff;
  font-weight: 600;
  padding: 10px 25px;
  border-radius: 10px;
  box-shadow: 0 5px #010916;
  transition: all 0.2s ease-in-out;
}
.btn-3d:active {
  transform: translateY(4px);
  box-shadow: 0 2px #052c65;
}
  #articleTable {
    animation: fadeInUp 0.8s ease-out;
  }

  /* 🌟 Animation de survol des lignes */
  #articleTable tbody tr {
    transition: transform 0.2s ease, background-color 0.3s ease;
  }

  #articleTable tbody tr:hover {
    background-color: #f8f9fa;
    transform: scale(1.02);
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
   /* 🧾 Apparition progressive des lignes (délai) */
  .trow1 {
    opacity: 0;
    animation: fadeInUp 0.6s forwards;
  }
  </style>
</head>

<body>
  

<%- include('partials/header')%>



  <main class="container py-4">
    <div class="card p-4 animate__animated animate__fadeInUp">
      <div class="d-flex flex-wrap justify-content-between align-items-center ">
        <h3 class="fw-semibold text-primary">📦 Liste des Articles</h3>
        <div class="d-flex flex-wrap gap-2 justify-content-center m-3">
          <a href="/ajouter" class="btn btn-warning btn-3d" title="AJOUTER UN NOUVEL ARTICLE">
            <i class="bi bi-plus-circle me-1"></i> 
          </a>
          <button id="exportPDF" class="btn btn-brand btn-3d" title="Exporter  (PDF)">
            <i class="bi bi-filetype-pdf me-1"></i> 
          </button>
          <button id="exportExcel" class="btn btn-success btn-3d" title="Exporter  (EXCEL)">
            <i class="bi bi-file-earmark-excel me-1"></i> 
          </button>

          <!-- 🆕 Nouveau bouton -->
          <button id="exportFiches" class="btn btn-danger btn-3d" title="Exporter toutes les fiches d'inventaire (PDF)">
            <i class="bi bi-clipboard2-data"></i>
          </button>
        </div>
      </div>

      <!-- 🧠 Filtres -->
      <div class="d-flex flex-wrap justify-content-between ">
        <div style="width:40% ;display: flex; flex-wrap: wrap;">
          <input  style="width:100%" list="designationList" id="designationFilter" class="filter-input" placeholder="Entrez la Designation" />
          <datalist id="designationList"></datalist>
        </div>

        <div style="width:40% ;display: flex; flex-wrap: wrap;">
          <input style="width:100%"  list="sectionList" id="sectionFilter" class="filter-input" placeholder="Entrez le nom de la section" />
          <datalist id="sectionList"></datalist>
        </div>
      </div>

      <!-- ✅ Tableau Articles -->
<div class="table-responsive mt-4 animate__animated animate__fadeIn">
  <table class="table table-hover align-middle shadow-sm rounded-4 overflow-hidden" id="articleTable">
    <thead class="table-dark">
      <tr>
        <th>Désignation</th>
        <th>Quantité</th>
        <th>Numéro</th>
        <th>Date</th>
        <th>Section</th>
        <th class="text-center">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (articles.length === 0) { %>
        <tr>
          <td colspan="6" class="text-center text-muted py-5">
            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
            Aucun article trouvé
          </td>
        </tr>
      <% } else { %>
        <% articles.forEach((article, i) => { %>
          <tr class="trow1" >
            <td><%= article.designation %></td>
            <td><%= article.qte %></td>
            <td><%= article.numero %></td>
            <td><%= article.date.toLocaleDateString() %></td>
            <td><%= article.section %></td>
            <td class="text-center">
              <div class="d-flex justify-content-center flex-wrap gap-2">
                <!-- Modifier -->
                <a href="/modifier/<%= article._id %>" class="btn btn-warning btn-sm px-3 shadow-sm" title="Modifier">
                  <i class="bi bi-pencil-square"></i>
                </a>

                <!-- Supprimer -->
                <button 
                  class="btn btn-danger btn-sm px-3 shadow-sm"
                  title="Supprimer"
                  onclick="if(confirm('🗑️ Supprimer cet article ?')) window.location.href='/supprimerarticle/<%= article._id %>'">
                  <i class="bi bi-trash"></i>
                </button>

                <!-- PDF -->
                <button class="btn btn-primary btn-sm px-3 shadow-sm"
                  title="Générer PDF"
                  onclick="generateDechargePDF('<%= article.designation %>', '<%= article.qte %>', '<%= article.numero %>', '<%= article.date.toLocaleDateString() %>', '<%= article.section %>')">
                  <i class="bi bi-file-earmark-pdf"></i>
                </button>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>
    </div>
  </main>

 <%- include('partials/footer') %>

  <!-- Bootstrap + XLSX + jsPDF -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

  <script>
    // 🧩 Remplir automatiquement les listes sans doublons
    window.addEventListener("DOMContentLoaded", () => {
      const designations = new Set();
      const sections = new Set();
      document.querySelectorAll("tbody tr").forEach(tr => {
        const tds = tr.querySelectorAll("td");
        if (tds.length) {
          designations.add(tds[0].textContent.trim());
          sections.add(tds[4].textContent.trim());
        }
      });

      const desList = document.getElementById("designationList");
      designations.forEach(val => desList.innerHTML += `<option value="${val}">`);
      const secList = document.getElementById("sectionList");
      sections.forEach(val => secList.innerHTML += `<option value="${val}">`);
    });

    // 🧠 Filtrage dynamique
    document.querySelectorAll("#designationFilter, #sectionFilter").forEach(input => {
      input.addEventListener("input", () => {
        const desVal = document.getElementById("designationFilter").value.toLowerCase();
        const secVal = document.getElementById("sectionFilter").value.toLowerCase();

        document.querySelectorAll("tbody tr").forEach(tr => {
          const designation = tr.children[0].textContent.toLowerCase();
          const section = tr.children[4].textContent.toLowerCase();
          tr.style.display =
            (designation.includes(desVal) && section.includes(secVal)) ? "" : "none";
        });
      });
    });

    
  </script>

  

    <script>
    document.addEventListener("DOMContentLoaded", () => {

      // ✅ Export PDF Global
      document.getElementById("exportPDF").addEventListener("click", () => {
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF("landscape", "mm", "a4"); // 👈 Mode paysage

        pdf.setFontSize(16);
        pdf.setTextColor(40);
        pdf.text(" Liste des Articles - APC Zighoud Youcef", 148, 15, { align: "center" });
        pdf.setFontSize(11);
        pdf.text(`Date : ${new Date().toLocaleDateString()}`, 14, 22);

        const table = document.querySelector("table");
        const head = [];
        const body = [];

        // 🧾 En-têtes
        table.querySelectorAll("thead th").forEach(th => head.push(th.textContent.trim()));

        // 🧾 Données (on ignore la colonne actions)
        table.querySelectorAll("tbody tr").forEach(tr => {
          if (tr.style.display !== "none") {
            const row = [];
            tr.querySelectorAll("td").forEach((td, i) => {
              if (i < 5) row.push(td.textContent.trim());
            });
            body.push(row);
          }
        });

        if (body.length === 0) {
          alert("Aucune donnée à exporter !");
          return;
        }

        // ✅ Génération du tableau PDF
        pdf.autoTable({
          head: [head.slice(0, 5)],
          body: body,
          startY: 30,
          theme: "striped",
          styles: { fontSize: 10, cellPadding: 4 },
          headStyles: { fillColor: [79, 70, 229], textColor: 255, fontStyle: "bold" },
          alternateRowStyles: { fillColor: [240, 240, 255] },
          margin: { left: 10, right: 10 },
        });

        // ✅ Pagination
        const pageCount = pdf.internal.getNumberOfPages();
        for (let i = 1; i <= pageCount; i++) {
          pdf.setPage(i);
          pdf.setFontSize(9);
          pdf.text(
            `Page ${i} / ${pageCount}`,
            pdf.internal.pageSize.getWidth() - 30,
            pdf.internal.pageSize.getHeight() - 10
          );
        }

        pdf.save("Liste_Articles_APC_Zighoud_Youcef.pdf");
      });

      // ✅ Export Excel
      document.getElementById("exportExcel").addEventListener("click", () => {
        const table = document.querySelector("table");

        const wb = XLSX.utils.book_new();
        const ws_data = [["Désignation", "Quantité", "Numéro", "Date", "Section"]];

        table.querySelectorAll("tbody tr").forEach(tr => {
          if (tr.style.display !== "none") {
            const row = [];
            tr.querySelectorAll("td").forEach((td, i) => {
              if (i < 5) row.push(td.textContent.trim());
            });
            ws_data.push(row);
          }
        });

        if (ws_data.length === 1) {
          alert("Aucune donnée à exporter !");
          return;
        }

        const ws = XLSX.utils.aoa_to_sheet(ws_data);
        XLSX.utils.book_append_sheet(wb, ws, "Articles");
        XLSX.writeFile(wb, "Liste_Articles.xlsx");
      });

    });
  
  </script>
  
<script>
  function generateDechargePDF(designation, qte, numero, date, section) {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ orientation: "portrait", unit: "mm", format: "a4" });

    // =============================
    // 🏛️ EN-TÊTE BILINGUE
    // =============================
    doc.setFont("helvetica", "bold");
    doc.setFontSize(11);
    doc.text("RÉPUBLIQUE ALGÉRIENNE DÉMOCRATIQUE ET POPULAIRE", 105, 15, { align: "center" });
    doc.setFont("helvetica", "normal");
    doc.text("Ministère de l’Intérieur, des Collectivités Locales et du Transport", 105, 21, { align: "center" });
    doc.text("Assemblée Populaire Communale de Zighoud Youcef", 105, 32, { align: "center" });

    // Ligne séparatrice
    doc.setLineWidth(0.5);
    doc.line(20, 40, 190, 40);

    // =============================
    // 🧾 TITRE DU DOCUMENT
    // =============================
    doc.setFont("helvetica", "bold");
    doc.setFontSize(16);
    doc.text("DÉCHARGE DE MATÉRIEL", 105, 53, { align: "center" });

    doc.setLineWidth(0.3);
    doc.line(70, 62, 140, 62);

    // =============================
    // 🧍 TEXTE D’INTRODUCTION
    // =============================
    doc.setFont("helvetica", "normal");
    doc.setFontSize(12);
    doc.text("Je soussigné(e) :", 25, 80);
    doc.line(65, 80, 180, 80);
    doc.text(`atteste avoir reçu, le ............................, le matériel suivant :`, 25, 90);

    // Version arabe à droite

    // =============================
    // 📋 TABLEAU DU MATÉRIEL
    // =============================
    const startY = 105;
    doc.setLineWidth(0.2);
    doc.rect(20, startY, 170, 45);

    doc.setFont("helvetica", "bold");
    doc.text("Désignation", 30, startY + 7);
    doc.text("Quantité", 100, startY + 7);
    doc.text("N° Série / Inventaire", 135, startY + 7);

    // Ligne horizontale
    doc.line(20, startY + 10, 190, startY + 10);

    // Contenu
    doc.setFont("helvetica", "normal");
    doc.text(designation, 30, startY + 18);
    doc.text(String(qte), 105, startY + 18, { align: "center" });
    doc.text(numero || "-", 150, startY + 18);

    // Section
    doc.text("Section bénéficiaire :", 25, startY + 35);
    doc.setFont("helvetica", "bold");
    doc.text(section, 70, startY + 35);
    

    // =============================
    // ✍️ SIGNATURES BILINGUES
    // =============================
    const sigY = startY + 70;
    doc.setFont("helvetica", "normal");
    doc.text("Le Responsable du Matériel", 35, sigY);
    doc.text("Le Bénéficiaire", 135, sigY);
    // Arabe
    
    // Lignes de signature
    doc.line(25, sigY + 20, 85, sigY + 20);
    doc.line(125, sigY + 20, 185, sigY + 20);

    // =============================
    // 📅 LIEU ET DATE
    // =============================
    doc.setFontSize(10);
    const today = new Date().toLocaleDateString("fr-DZ");
    doc.text(`Fait à Zighoud Youcef, le ${today}`, 25, sigY + 40);

    // =============================
    // 🪶 CADRE EXTÉRIEUR (style officiel)
    // =============================
    doc.setLineWidth(0.8);
    doc.rect(15, 10, 180, 270);

    // =============================
    // 💾 SAUVEGARDE DU PDF
    // =============================
    doc.save(`Decharge_${designation}.pdf`);
  }
</script>

<script>
document.getElementById("exportFiches").addEventListener("click", () => {
  const { jsPDF } = window.jspdf;
  const rows = document.querySelectorAll("#articleTable tbody tr");
  if (rows.length === 0) return alert("⚠️ Aucun article trouvé !");

  // 🧩 Regrouper les articles par section
  const sections = {};
  rows.forEach(tr => {
    if (tr.style.display !== "none") {
      const tds = tr.querySelectorAll("td");
      const designation = tds[0].textContent.trim();
      const qte = tds[1].textContent.trim();
      const numero = tds[2].textContent.trim();
      const date = tds[3].textContent.trim();
      const section = tds[4].textContent.trim();
      if (!sections[section]) sections[section] = [];
      sections[section].push({ designation, qte, numero, date });
    }
  });

  let exported = 0;

  for (const section in sections) {
    const doc = new jsPDF({ orientation: "landscape", unit: "mm", format: "a4" });

    // 🏛️ En-tête officiel
    doc.setFont("helvetica", "bold");
    doc.setFontSize(11);
    doc.text("RÉPUBLIQUE ALGÉRIENNE DÉMOCRATIQUE ET POPULAIRE", 148.5, 15, { align: "center" });
    doc.setFont("helvetica", "normal");
    doc.text("Ministère de l’Intérieur, des Collectivités Locales et du Transport", 148.5, 21, { align: "center" });
    doc.text("Assemblée Populaire Communale de Zighoud Youcef", 148.5, 28, { align: "center" });
    doc.line(20, 35, 275, 35);

    // 🧾 Titre
    doc.setFont("helvetica", "bold");
    doc.setFontSize(16);
    doc.text(`FICHE D’INVENTAIRE - SECTION ${section}`, 148.5, 48, { align: "center" });
    doc.line(70, 53, 225, 53);

    // 🧮 Tableau
    const headers = ["N°", "Désignation", "Quantité", "Numéro de série", "Date"];
    const startX = 20;
    let startY = 65;
    const rowHeight = 10;
    const colWidths = [15, 120, 25, 60, 30];

    // 🎨 EN-TÊTE DU TABLEAU
    let x = startX;
    doc.setFillColor(66, 133, 244); // Bleu Google moderne
    doc.setTextColor(245, 245, 245); // Texte blanc
    
    doc.setFont("helvetica", "bold");

    headers.forEach((header, i) => {
      doc.rect(x, startY, colWidths[i], rowHeight, "FD"); // Fond + bordure
      const textWidth = doc.getTextWidth(header);
      const textX = x + (colWidths[i] - textWidth) / 2;
      const textY = startY + rowHeight / 2 + 3;
      doc.text(header, textX, textY);
      x += colWidths[i];
      doc.setFillColor(66, 133, 244); // Bleu Google moderne
      doc.setTextColor(245, 245, 245); // Texte blanc
    });

    // 📋 LIGNES DU TABLEAU (avec couleurs alternées)
    startY += rowHeight;
    doc.setFont("helvetica", "normal");
    doc.setTextColor(0, 0, 0);

    sections[section].forEach((art, index) => {
      x = startX;
      const values = [index + 1, art.designation, art.qte, art.numero, art.date];

      // 🟦 Alternance de couleurs de ligne
      if (index % 2 === 0) {
        doc.setFillColor(240, 248, 255); // Bleu très clair
        doc.rect(startX, startY, colWidths.reduce((a, b) => a + b, 0), rowHeight, "F");
      }

      // 📝 Dessin des cellules
      values.forEach((val, i) => {
        doc.rect(x, startY, colWidths[i], rowHeight); // Bordure
        const textWidth = doc.getTextWidth(String(val));
        const textX = x + (colWidths[i] - textWidth) / 2;
        const textY = startY + rowHeight / 2 + 3;
        doc.text(String(val), textX, textY);
        x += colWidths[i];
      });

      startY += rowHeight;

      // 🔁 Nouvelle page si dépassement
      if (startY > 180) {
        doc.addPage("a4", "landscape");
        startY = 30;
      }
    });

    // 📅 Pied de page
    const today = new Date().toLocaleDateString("fr-DZ");
    doc.setFontSize(10);
    doc.text(`Fait à Zighoud Youcef, le ${today}`, 25, 185);
    doc.text("Signature :", 200, 185);

    // 🔲 Cadre général
    doc.setLineWidth(0.8);
    doc.rect(15, 10, 267, 190);

    // 💾 Enregistrer le fichier
    doc.save(`Fiche_Inventaire_${section}.pdf`);
    exported++;
  }

  if (exported === 0) alert("Aucune section à exporter !");
  else alert(`✅ ${exported} fiche(s) d'inventaire exportée(s) (style amélioré).`);
});
</script>





</body>
</html>
