<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>➕ Ajouter une Section</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Animate.css pour les animations -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

  <style>
    /* 🌆 Arrière-plan pro et sobre */
    body {
      background: linear-gradient(135deg, #eef2f3 0%, #dfe9f3 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      font-family: "Poppins", sans-serif;
    }

    /* 🧭 Conteneur principal centré */
    .container {
      max-width: 600px;
      margin: auto;
      padding-top: 80px;
      flex-grow: 1;
    }

    /* 💎 Carte élégante */
    .card {
      border: none;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      background: #ffffff;
      animation: fadeInUp 0.8s ease;
    }

    h3 {
      font-weight: 700;
      color: #0d6efd;
      letter-spacing: 0.5px;
    }

    /* 🧾 Champs de saisie */
    .form-control {
      border-radius: 10px;
      border: 1px solid #ced4da;
      transition: all 0.3s ease;
    }

    .form-control:focus {
      border-color: #0d6efd;
      box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    /* 🟦 Bouton principal stylé */
    .btn-custom {
      background: linear-gradient(90deg, #0d6efd, #0b5ed7);
      color: #fff;
      font-weight: 600;
      border: none;
      border-radius: 10px;
      padding: 10px 25px;
      transition: all 0.25s ease;
    }

    .btn-custom:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 18px rgba(13, 110, 253, 0.3);
    }

    .btn-secondary {
      border-radius: 10px;
      padding: 10px 25px;
    }

    /* 📱 Réactivité */
    @media (max-width: 576px) {
      .card {
        padding: 1.5rem !important;
      }
      h3 {
        font-size: 1.3rem;
      }
    }

    /* ✨ Animation douce */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(25px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ⚪ Footer simple et pro */
    footer {
      text-align: center;
      color: #6c757d;
      padding: 20px 0;
      font-size: 0.9rem;
    }
  </style>
</head>
<body>
 


  <div class="container">
    <div class="card p-5 animate__animated animate__fadeInUp">
      <h3 class="text-center mb-4">➕ Ajouter une Section</h3>

      <form action="/sections/ajouter" method="POST">
        <div class="mb-3">
          <label for="section_name" class="form-label fw-semibold">Nom de la section</label>
          <input 
            type="text" 
            name="section_name" 
            id="section_name" 
            class="form-control" 
            placeholder="Ex : Informatique, Comptabilité..." 
            required 
            autofocus>
        </div>

        <div class="d-flex justify-content-between mt-4">
          <a href="/sections/affichersections" class="btn btn-secondary">⬅️ Retour</a>
          <button type="submit" class="btn btn-custom">💾 Enregistrer</button>
        </div>
      </form>
    </div>
  </div>

  <footer>
    &copy; <%= new Date().getFullYear() %> - Gestion des Sections | Interface moderne & professionnelle 🧠
  </footer>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
