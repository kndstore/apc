<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>✏️ Modifier Section</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Icônes Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

  <!-- 🌈 Style personnalisé -->
  <style>
    /* Arrière-plan dégradé moderne */
    body {
      background: linear-gradient(135deg, #74ebd5, #ACB6E5);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      
      color: #333;
      animation: fadeIn 1s ease-in-out;
    }

    /* Animation d’apparition */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Carte principale (effet verre) */
    .card-glass {
      backdrop-filter: blur(12px);
      background: rgba(255, 255, 255, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.4);
      border-radius: 20px;
      box-shadow: 0 8px 32px rgba(31, 38, 135, 0.2);
      color: #333;
      width: 100%;
      max-width: 500px;
      padding: 2rem;
      animation: slideIn 0.8s ease;
    }

    @keyframes slideIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }

    /* Champs de formulaire */
    .form-control {
      border-radius: 12px;
      border: 1px solid rgba(0, 0, 0, 0.1);
      transition: all 0.3s ease;
      background-color: rgba(255, 255, 255, 0.8);
    }

    .form-control:focus {
      border-color: #007bff;
      box-shadow: 0 0 10px rgba(13, 110, 253, 0.2);
    }

    /* Boutons stylisés */
    .btn {
      border-radius: 12px;
      transition: all 0.3s ease;
      padding: 10px 18px;
      font-weight: 500;
    }

    .btn-primary {
      background: linear-gradient(90deg, #4e54c8, #8f94fb);
      border: none;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(78, 84, 200, 0.4);
    }

    .btn-secondary:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(108, 117, 125, 0.3);
    }

    /* Titre stylisé */
    h2 {
      background: linear-gradient(90deg, #007bff, #00c6ff);
     
      -webkit-text-fill-color: transparent;
      font-weight: 700;
      letter-spacing: 1px;
    }

    /* Animation du bouton au clic */
    .btn:active {
      transform: scale(0.97);
    }

    /* Icônes animées */
    .btn i {
      margin-right: 5px;
      transition: transform 0.2s ease;
    }

    .btn:hover i {
      transform: rotate(-10deg) scale(1.1);
    }

    /* Fond légèrement grisé au-dessus du dégradé */
    .overlay {
      background-color: rgba(170, 170, 170, 0.1);
      position: fixed;
      inset: 0;
      z-index: -1;
    }
  </style>
</head>

<body>
  <div class="overlay"></div>

  <!-- Header -->
 


<!-- Contenu principal -->
  <div class="card-glass text-center">
    <h2 class="mb-4"><i class="bi bi-pencil-square"></i> Modifier la Section</h2>

    <form action="/sections/modifier/<%= section._id %>" method="POST">
      <div class="mb-4 text-start">
        <label for="section_name" class="form-label fw-semibold">Nom de la section</label>
        <input 
          type="text" 
          id="section_name" 
          name="section_name" 
          class="form-control form-control-lg" 
          placeholder="Saisir le nom de la section" 
          value="<%= section.section_name %>" 
          required>
      </div>

      <div class="d-flex justify-content-center gap-3 mt-4">
        <button type="submit" class="btn btn-primary shadow-sm">
          <i class="bi bi-save"></i> Enregistrer
        </button>
        <a href="/sections/affichersections" class="btn btn-secondary shadow-sm">
          <i class="bi bi-arrow-left-circle"></i> Retour
        </a>
      </div>
    </form>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
