<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dashboard Utilisateurs</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      background: linear-gradient(135deg, #f0f4ff, #e6f0ff);
      font-family: "Poppins", sans-serif;
      color: #333;
      animation: fadeIn 1s ease-in-out;
    }

    h1, h2 {
      font-weight: 600;
      text-align: center;
      color: #0d6efd;
      text-shadow: 0 2px 4px rgba(13, 110, 253, 0.2);
      animation: slideDown 1s ease;
    }

    .card {
      border: none;
      border-radius: 1rem;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      transition: all 0.3s ease-in-out;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
    }

    .table {
      border-radius: 0.5rem;
      overflow: hidden;
      background: white;
    }

    thead {
      background: #0d6efd;
      color: white;
    }

    tbody tr:hover {
      background-color: rgba(13, 110, 253, 0.08);
      transition: 0.2s;
    }

    .btn {
      transition: all 0.3s ease;
      border-radius: 30px;
      font-weight: 500;
    }

    .btn:hover {
      transform: scale(1.05);
    }

    .modal-content {
      border-radius: 1rem;
      animation: zoomIn 0.3s ease;
    }

    .btn-retour {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background-color: #0d6efd;
      color: white;
      border: none;
      border-radius: 30px;
      padding: 8px 16px;
      text-decoration: none;
      transition: all 0.3s ease;
      box-shadow: 0 3px 6px rgba(13, 110, 253, 0.2);
    }

    .btn-retour:hover {
      background-color: #0b5ed7;
      transform: translateY(-2px);
      box-shadow: 0 5px 12px rgba(13, 110, 253, 0.3);
    }

    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes slideDown { from { transform: translateY(-20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    @keyframes zoomIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }

    footer {
      margin-top: 40px;
      text-align: center;
      font-size: 0.9rem;
      color: #6c757d;
    }
  </style>
</head>

<body>
  <div class="container mt-5">
    <!-- 🧭 Bouton Retour -->
    <div class="mb-4">
      <a href="/" class="btn-retour">
        <i class="bi bi-arrow-left"></i> Déconnexion
      </a>
    </div>

    <h1 class="mb-4">Tableau de bord - Utilisateurs</h1>

    <% if (message) { %>
      <div class="alert alert-warning text-center shadow-sm"><%= message %></div>
    <% } %>

    <!-- 🧩 Formulaire Ajouter Utilisateur -->
    <div class="card mb-5">
      <div class="card-header bg-primary text-white fw-semibold">➕ Ajouter un utilisateur</div>
      <div class="card-body">
        <form action="/dashboard/ajouterUSER" method="POST">
          <div class="row g-3">
            <div class="col-md-2">
              <input type="text" class="form-control" placeholder="Matricule" name="mle" required>
            </div>
            <div class="col-md-3">
              <input type="text" class="form-control" placeholder="Nom complet" name="name" required>
            </div>
            <div class="col-md-3">
              <input type="text" class="form-control" placeholder="Nom d'utilisateur" name="username" required>
            </div>
            <div class="col-md-2">
              <input type="password" class="form-control" placeholder="Mot de passe" name="password" required>
            </div>
            <div class="col-md-2">
              <select class="form-select" name="role" required>
                <option value="">Rôle</option>
                <option value="admin">Admin</option>
                <option value="user">Utilisateur</option>
              </select>
            </div>
          </div>
          <div class="text-end mt-4">
            <button type="submit" class="btn btn-primary px-4 shadow-sm">
              <i class="bi bi-person-plus"></i> Ajouter
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- 🧍 Liste des utilisateurs -->
    <h2 class="mb-3">👥 Liste des utilisateurs</h2>
    <div class="table-responsive">
      <table class="table align-middle table-hover text-center">
        <thead>
          <tr>
            <th>Mle</th>
            <th>Nom</th>
            <th>Username</th>
            <th>Password</th>
            <th>Rôle</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% utilisateurs.forEach(u => { %>
            <tr>
              <td><%= u.mle %></td>
              <td><%= u.name %></td>
              <td><%= u.username %></td>
              <td><%= u.password %></td>
              <td><span class="badge bg-<%= u.role === 'admin' ? 'danger' : 'secondary' %>"><%= u.role %></span></td>
              <td>
                <button class="btn btn-sm btn-outline-warning me-1" data-bs-toggle="modal" data-bs-target="#modal<%= u._id %>">
                  <i class="bi bi-pencil-square"></i> Modifier
                </button>
                <a href="/dashboard/supprimer/<%= u._id %>" class="btn btn-sm btn-outline-danger">
                  <i class="bi bi-trash"></i> Supprimer
                </a>
              </td>
            </tr>

            <!-- 🪄 Modal de modification -->
            <div class="modal fade" id="modal<%= u._id %>" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                  <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title"><i class="bi bi-pencil"></i> Modifier l'utilisateur</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                  </div>
                  <form action="/dashboard/modifier/<%= u._id %>" method="POST">
                    <div class="modal-body">
                      <div class="mb-2">
                        <label>Mle</label>
                        <input type="text" name="mle" value="<%= u.mle %>" class="form-control" required>
                      </div>
                      <div class="mb-2">
                        <label>Nom</label>
                        <input type="text" name="name" value="<%= u.name %>" class="form-control" required>
                      </div>
                      <div class="mb-2">
                        <label>Username</label>
                        <input type="text" name="username" value="<%= u.username %>" class="form-control" required>
                      </div>
                      <div class="mb-2">
                        <label>Password</label>
                        <input type="text" name="password" value="<%= u.password %>" class="form-control" required>
                      </div>
                      <div class="mb-2">
                        <label>Rôle</label>
                        <select name="role" class="form-select" required>
                          <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                          <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>Utilisateur</option>
                        </select>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                      <button type="submit" class="btn btn-warning text-white">Sauvegarder</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </tbody>
      </table>
    </div>

    <footer>
      © <%= new Date().getFullYear() %> — Tableau de bord élégant par <b>Bootstrap 5</b> ✨
    </footer>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
</body>
</html>
